SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
# Direct Zalo profile or OA URL opened by the support button.
ZALO_URL=https://zalo.me/your-zalo-id
# Laragon default: root with no password. Add a password if you configured one.
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/store_management_db?charset=utf8mb4
# Use mock for local testing: OTPs appear in the app console and are not sent.
# Set to live to use the SMTP and eSMS credentials below.
OTP_DELIVERY_MODE=mock

# Email OTP delivery (used only when OTP_DELIVERY_MODE=live)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=test@localhost
SMTP_FROM_NAME=Phuc Thinh ICT
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# SMS OTP delivery (used only when OTP_DELIVERY_MODE=live)
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRAND_NAME=
ESMS_SMS_TYPE=2
# Optional override for the eSMS REST endpoint
# ESMS_API_URL=https://rest.esms.vn/MainService.svc/json/SendMultipleMessage_V4_post_json/
