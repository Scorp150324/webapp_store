SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=store_management_db
DB_USER=root
DB_PASSWORD=

# Use mock for local testing: OTPs appear in the app console and are not sent.
# Set to live to use the SMTP and eSMS credentials below.
OTP_DELIVERY_MODE=mock

# Email OTP delivery (used only when OTP_DELIVERY_MODE=live)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=test@localhost
SMTP_FROM_NAME=Phuc Thinh ICT
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# SMS OTP delivery (used only when OTP_DELIVERY_MODE=live)
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRAND_NAME=
ESMS_SMS_TYPE=2
# Optional override for the eSMS REST endpoint
# ESMS_API_URL=https://rest.esms.vn/MainService.svc/json/SendMultipleMessage_V4_post_json/
